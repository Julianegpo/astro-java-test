<file path="server/config-server/src/main/resources/config/gateway-server.yml">
# gateway-server (D3: fixed 8080; single entry point - D6). lb:// routes resolved by
# name via Eureka (the services use random ports); the 2 api-docs loops let the
# aggregated swagger at the gateway (T10) fetch each service's OpenAPI.
# Spring Cloud Gateway 4.3.x server.webflux.* namespace verified against the jar
# metadata: the legacy spring.cloud.gateway.* namespace is deprecated.
# The Eureka URL arrives from the shared config (config/application.yml).
server:
  port: 8080

spring:
  cloud:
    gateway:
      server:
        webflux:
          routes:
            - id: auth-token
              uri: lb://auth-service
              predicates:
                - Path=/api/auth/token
                - Method=POST
            - id: demo-api
              uri: lb://demo-service
              predicates:
                - Path=/api/demo/**
            - id: api-docs-auth-service
              uri: lb://auth-service
              predicates:
                - Path=/v3/api-docs/auth-service
              filters:
                - RewritePath=/v3/api-docs/auth-service, /v3/api-docs
            - id: api-docs-demo-service
              uri: lb://demo-service
              predicates:
                - Path=/v3/api-docs/demo-service
              filters:
                - RewritePath=/v3/api-docs/demo-service, /v3/api-docs

