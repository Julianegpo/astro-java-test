package com.demo.gatewayserver;

import static org.assertj.core.api.Assertions.assertThat;

import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.reactive.AutoConfigureWebTestClient;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.test.web.reactive.server.WebTestClient;

/**
 * Aggregated Swagger at the gateway (T10, D17/D22): the UI entry point is served and its
 * swagger-config advertises the OpenAPI documents of both services through the api-docs loops
 * (relative URLs only — services are discovered by name, never by port).
 */
@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
@AutoConfigureWebTestClient
class GatewaySwaggerAggregationTests {

  @Autowired private WebTestClient webTestClient;

  @Test
  void swaggerUiIsServedAtTheGatewayEntryPoint() {
    webTestClient.get().uri("/swagger-ui/index.html").exchange().expectStatus().isOk();
  }

  @Test
  void swaggerConfigListsAuthAndDemoServiceDocs() {
    webTestClient
        .get()
        .uri("/v3/api-docs/swagger-config")
        .exchange()
        .expectStatus()
        .isOk()
        .expectBody(String.class)
        .value(
            body -> {
              assertThat(body).contains("/v3/api-docs/auth-service");
              assertThat(body).contains("/v3/api-docs/demo-service");
            });
  }
}
