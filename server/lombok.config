# Lombok config - raiz del multi-modulo server/ (D8)
config.stopBubbling = true

# No infla la cobertura de JaCoCo con metodos generados
lombok.addLombokGeneratedAnnotation = true

# @Jacksonized debe fijar Jackson 2 (Boot 3.5); sin esto Lombok avisa de ambiguedad Jackson2/3
lombok.jacksonized.jacksonVersion = 2
