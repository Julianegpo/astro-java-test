# Lombok config - root of the server/ multi-module build (D8)
config.stopBubbling = true

# Do not inflate JaCoCo coverage with generated methods
lombok.addLombokGeneratedAnnotation = true

# @Jacksonized must pin Jackson 2 (Boot 3.5); without this Lombok warns about Jackson2/3 ambiguity
lombok.jacksonized.jacksonVersion = 2
